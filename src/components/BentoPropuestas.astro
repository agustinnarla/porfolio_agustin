---
import Propuesta from "./Propuesta.astro";
---

<section class="py-16 px-8 bg-linear-to-br from-indigo-50 via-white to-purple-50" id="propuestas">
 
    <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-800 relative inline-block after:content-[''] after:absolute after:bottom-[-10px] after:left-1/2 after:transform after:-translate-x-1/2 after:w-16 after:h-1 after:bg-linear-to-r after:from-indigo-500 after:to-purple-600 after:rounded-md mb-4">
            Propuestas
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Servicios que ofrezco como desarrollador full stack para llevar tus ideas al siguiente nivel
        </p>
    </div>

    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <Propuesta 
            title="Desarrollo Web" 
            description="Creación de aplicaciones web modernas y escalables con las últimas tecnologías del mercado. Desde SPA hasta complejos sistemas empresariales."
            icon="🌐"
        />
        <Propuesta 
            title="Desarrollo Móviles" 
            description="Aplicaciones móviles híbridas para iOS y Android. Experiencia fluida y rendimiento optimizado para cualquier dispositivo."
            icon="📱"
        />
        <Propuesta 
            title="Landing Pages" 
            description="Diseño y desarrollo de landing pages optimizadas para conversión. Atractivas visualmente y enfocadas en resultados."
            icon="🎯"
        />
        <Propuesta 
            title="E-commerce" 
            description="Tiendas online completas con pasarelas de pago, gestión de inventario y panel de administración intuitivo."
            icon="🛒"
        />
        <Propuesta 
            title="APIs" 
            description="Diseño y construcción de APIs RESTful robustas, seguras y documentadas para integraciones perfectas."
            icon="⚡"
        />
       
    </div>

    
</section>