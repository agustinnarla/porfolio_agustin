---
import { Mail, Clock, Send } from "lucide-astro";
---

<section id="contacto" class="py-24 bg-[#F5F5F4]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div>
        <p class="text-sm font-medium tracking-widest uppercase text-[#A8A29E] mb-3">
          Contacto
        </p>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tight mb-6" style="font-family: var(--font-display);">
          Hablemos
        </h2>
        <p class="text-[#78716C] leading-relaxed mb-8 max-w-md">
          ¿Tenés un proyecto en mente o querés conectar? Mandame un mensaje y
          te respondo lo antes posible.
        </p>

        <div class="space-y-4">
          <div class="flex items-center gap-3 text-sm text-[#78716C]">
            <Mail class="w-4 h-4 text-[#A8A29E]" />
            <span>agustin.arla.dev@gmail.com</span>
          </div>
          <div class="flex items-center gap-3 text-sm text-[#78716C]">
            <Clock class="w-4 h-4 text-[#A8A29E]" />
            <span>Respuesta en 24hs</span>
          </div>
        </div>
      </div>

      <div>
        <form
          action="https://formspree.io/f/xpqrdjjd"
          method="POST"
          class="space-y-5"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <label for="name" class="block text-sm font-medium text-[#1C1917]">
                Nombre
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full px-4 py-2.5 text-sm bg-white border border-[#E7E5E4] rounded-lg focus:outline-none focus:border-[#1C1917] transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" class="block text-sm font-medium text-[#1C1917]">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full px-4 py-2.5 text-sm bg-white border border-[#E7E5E4] rounded-lg focus:outline-none focus:border-[#1C1917] transition-colors"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="subject" class="block text-sm font-medium text-[#1C1917]">
              Asunto
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Propuesta de proyecto"
              class="w-full px-4 py-2.5 text-sm bg-white border border-[#E7E5E4] rounded-lg focus:outline-none focus:border-[#1C1917] transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="message" class="block text-sm font-medium text-[#1C1917]">
              Mensaje
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Contame sobre tu proyecto..."
              class="w-full px-4 py-2.5 text-sm bg-white border border-[#E7E5E4] rounded-lg focus:outline-none focus:border-[#1C1917] transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-[#1C1917] text-[#FAFAF9] text-sm font-medium rounded-lg hover:bg-[#0C0A09] transition-colors"
          >
            <Send class="w-4 h-4" />
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
