---
import { Menu, X } from "lucide-astro";
---

<header class="sticky top-0 z-50 bg-[#FAFAF9]/80 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-6 py-4">
    <nav class="flex items-center justify-between">
      <a href="/" class="text-lg font-bold tracking-tight text-[#1C1917]">
        agustín arla
      </a>

      <ul class="hidden md:flex items-center gap-8">
        <li><a href="#home" class="link-underline text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors">Inicio</a></li>
        <li><a href="#tecnologias" class="link-underline text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors">Stack</a></li>
        <li><a href="#proyectos" class="link-underline text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors">Proyectos</a></li>
        <li><a href="#contacto" class="link-underline text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors">Contacto</a></li>
      </ul>

      <button
        id="mobile-menu-button"
        class="md:hidden p-2 -mr-2 text-[#78716C] hover:text-[#1C1917] transition-colors"
        aria-label="Abrir menú"
      >
        <Menu class="w-5 h-5" />
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 pb-4 border-t border-[#E7E5E4] pt-4"
    >
      <ul class="flex flex-col gap-3">
        <li><a href="#home" class="block text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors py-1">Inicio</a></li>
        <li><a href="#tecnologias" class="block text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors py-1">Stack</a></li>
        <li><a href="#proyectos" class="block text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors py-1">Proyectos</a></li>
        <li><a href="#contacto" class="block text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors py-1">Contacto</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");

    btn?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => menu?.classList.add("hidden"));
    });
  });
</script>
