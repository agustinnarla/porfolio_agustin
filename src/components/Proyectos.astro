---
import Card from "./Card.astro";
import fotoColegio from '../assets/logo-huerto.png';
import fotoFinanzas from '../assets/logo-finanzas.png';
import fotoVibbes from '../assets/thavibbescompany.webp';
---

<section class="py-16 px-8 bg-linear-to-br from-gray-50 to-white" id="proyectos">
   
    <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-800 relative inline-block after:content-[''] after:absolute after:bottom-[-10px] after:left-1/2 after:transform after:-translate-x-1/2 after:w-16 after:h-1 after:bg-linear-to-r after:from-indigo-500 after:to-purple-600 after:rounded-md">
            Proyectos
        </h2>
        <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto">
            Algunos de mis proyectos más destacados donde he aplicado diferentes tecnologías y soluciones creativas
        </p>
    </div>

  
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10 max-w-6xl mx-auto">
        <Card
            title="Gestión Colegio Nuestra Señora del Huerto"
            description="Sistema de gestión integral para el colegio Nuestra Señora del Huerto, realizado como trabajo final para la carrera Analista de Sistema en el Colegio Universitario IES21. Incluye módulos de administración, gestión de alumnos y personal."
            image={fotoColegio}
            enlace="https://youtu.be/1ia6A2C0qoc"
            link="https://github.com/agustinnarla/GestionColegio"
            technologies={["React Native", "Node.js", "PostgreSQL"]}
        />
        <Card
            title="Finanzas Agustin"
            description="Aplicación web moderna para gestionar finanzas personales con dashboard interactivo, categorización de gastos, reportes detallados y visualización de datos en tiempo real."
            image={fotoFinanzas}
            enlace="https://youtu.be/7q9x0MM5I3I"
            link="https://github.com/agustinnarla/finanzas-agus"
            technologies={["React", "Node.js", "PostgreSQL"]}
        />
        <Card
            title="Tha Vibbes Company"
            description="Landing Page para un grupo de baile, de Córdoba, Argentina,  la cual nos va a representar en el mundial de hip hop HHI 2026. "
            image={fotoVibbes}
            enlace="https://tha-vibbes-company.vercel.app/"
            link="https://github.com/agustinnarla/ThaVibbesCompany"
            technologies={["Astro", "TypeScript"]}
        />
    </div>

    <div class="text-center mt-12">
        <a 
            href="https://github.com/agustinnarla" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-indigo-500 text-indigo-600 font-semibold rounded-lg transition-all duration-300 hover:bg-indigo-500 hover:text-white hover:shadow-lg hover:scale-105 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Ver más proyectos en GitHub
        </a>
    </div>
</section>