---
import { ExternalLink, Github } from "lucide-astro";

const projects = [
  {
    title: "Gestión Nuestra Señora del Huerto",
    description:
      "Plataforma omnicanal para la digitalización de instituciones educativas. Eliminación total del uso de papel con módulos de asistencia, amonestaciones, notas y observaciones en tiempo real.",
    image: "/images/appColegio.webp",
    tags: ["React Native", "Expo", "Node.js", "PostgreSQL"],
    liveUrl: "https://youtu.be/1ia6A2C0qoc",
    githubUrl: "https://github.com/agustinnarla/GestionColegio",
  },
  {
    title: "Landing Tha Vibbes Company",
    description:
      "Landing page oficial para crew de danza urbana de Córdoba, representantes de Argentina en el mundial de Hip Hop International 2026. Estética de alto impacto visual y cultura urbana.",
    image: "/images/landingThaVibbes.webp",
    tags: ["React Native", "Expo", "PostgreSQL"],
    liveUrl: "https://tha-vibbes-company.vercel.app/",
    githubUrl: "https://github.com/agustinnarla/ThaVibbesCompany",
  },
  {
    title: "Landing Estudio Jurídico",
    description:
      "Landing page enfocada en transmitir solidez y profesionalismo. Arquitectura de información clara, paleta institucional y tipografía limpia para resaltar trayectoria.",
    image: "/images/landingAbogados.webp",
    tags: ["Astro", "Tailwind"],
    liveUrl: "https://abogado-landing-alpha.vercel.app/",
    githubUrl: "https://github.com/agustinnarla/AbogadoLanding",
  },
  {
    title: "Indarra",
    description:
      "Aplicación móvil para seguimiento personalizado de rutinas de ejercicio. Módulo avanzado de analítica para registrar progreso y evaluar evolución de cargas.",
    image: "/images/appIndarra.webp",
    tags: ["React Native", "Expo", "PostgreSQL"],
    liveUrl: "https://youtube.com/shorts/h_xxbB0ZyPU",
    githubUrl: "https://github.com/agustinnarla/Indarra.git",
  },
];
---

<section id="proyectos" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="mb-16">
      <p class="text-sm font-medium tracking-widest uppercase text-[#A8A29E] mb-3">
        Proyectos
      </p>
      <h2 class="text-3xl lg:text-4xl font-bold tracking-tight" style="font-family: var(--font-display);">
        Trabajos recientes
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="group rounded-xl border border-[#E7E5E4] overflow-hidden hover:border-[#D6D3D1] hover:shadow-sm transition-all duration-300">
          <div class="relative h-52 overflow-hidden bg-[#F5F5F4]">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-6">
            <h3 class="text-lg font-bold text-[#1C1917] mb-2">
              {project.title}
            </h3>
            <p class="text-sm text-[#78716C] leading-relaxed mb-4">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-5">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-0.5 text-xs font-medium text-[#78716C] border border-[#E7E5E4] rounded-full">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4">
              <a
                href={project.liveUrl}
                class="inline-flex items-center gap-1.5 text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                <ExternalLink class="w-3.5 h-3.5" />
                Demo
              </a>
              <a
                href={project.githubUrl}
                class="inline-flex items-center gap-1.5 text-sm font-medium text-[#78716C] hover:text-[#1C1917] transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Github class="w-3.5 h-3.5" />
                Código
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
