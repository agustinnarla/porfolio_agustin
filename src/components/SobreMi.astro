---
import { Image } from "astro:assets";
import agus from "../assets/agus.jpeg";
---

<section id="home" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-white to-cyan-50/30">
  <div class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      <!-- Content -->
      <div class="flex-1 text-center lg:text-left space-y-6">
        <div class="space-y-4">
          <h1 class="text-4xl lg:text-6xl font-bold text-gray-800 leading-tight">
            Hola. Soy <span class="text-cyan-600">Agustín Arla</span>
          </h1>
          
          <div class="space-y-2">
            <p class="text-xl lg:text-2xl text-gray-600 font-light">
              Analista de Sistemas y Desarrollador de Software
            </p>
            
            <p class="text-lg text-gray-500">
              Especializado en crear experiencias digitales excepcionales
            </p>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a 
            href="#proyectos" 
            class="px-6 py-3 bg-cyan-600 text-white font-medium rounded-lg hover:bg-cyan-700 transition-colors duration-200"
          >
            Ver Proyectos
          </a>
          <a 
            href="#contacto" 
            class="px-6 py-3 border border-cyan-600 text-cyan-600 font-medium rounded-lg hover:bg-cyan-50 transition-colors duration-200"
          >
            Contactar
          </a>
        </div>

        <!-- Skills tags -->
        <div class="flex flex-wrap gap-2 justify-center lg:justify-start">
          <span class="px-3 py-1 bg-cyan-100 text-cyan-700 text-sm font-medium rounded-full">React</span>
          <span class="px-3 py-1 bg-cyan-100 text-cyan-700 text-sm font-medium rounded-full">Node.js</span>
          <span class="px-3 py-1 bg-cyan-100 text-cyan-700 text-sm font-medium rounded-full">Tailwind</span>
          <span class="px-3 py-1 bg-cyan-100 text-cyan-700 text-sm font-medium rounded-full">Astro</span>
        </div>
      </div>

      <!-- Image -->
      <div class="flex-shrink-0">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-400 to-cyan-600 rounded-full blur-2xl opacity-20 scale-110"></div>
          <Image
            src={agus}
            alt="Agustín Arla - Analista de Sistemas y Desarrollador de Software"
            width={320}
            height={320}
            class="relative rounded-2xl w-64 h-64 lg:w-80 lg:h-80 object-cover shadow-2xl border-4 border-white"
          />
        </div>
      </div>
    </div>
  </div>
</section>