---
import { Image } from "astro:assets";
import agus from "../assets/agus.jpeg";
import { ArrowDown, Mail } from "lucide-astro";
---

<section id="home" class="min-h-screen flex items-center">
    <div class="max-w-5xl mx-auto px-6 py-24 w-full">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
        >
            <div class="lg:col-span-7 space-y-8">
                <div class="space-y-4">
                    <p
                        class="text-sm font-medium tracking-widest uppercase text-[#A8A29E]"
                    >
                        Desarrollador Fullstack
                    </p>
                    <h1
                        class="text-5xl lg:text-7xl font-bold leading-[1.05] tracking-tight"
                        style="font-family: var(--font-display);"
                    >
                        Hola, soy
                        <br />
                        <span class="text-[#1C1917]">Agustín Arla</span>
                    </h1>
                    <p class="text-lg text-[#78716C] leading-relaxed max-w-lg">
                        Analista funcional y Desarrollador de Software,
                        especializado en crear experiencias digitales modernas y
                        eficientes.
                    </p>
                </div>

                <div class="flex flex-wrap gap-3">
                    <a
                        href="#proyectos"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-[#1C1917] text-[#FAFAF9] text-sm font-medium rounded-full hover:bg-[#0C0A09] transition-colors"
                    >
                        Ver proyectos
                        <ArrowDown class="w-4 h-4" />
                    </a>
                    <a
                        href="#contacto"
                        class="inline-flex items-center gap-2 px-6 py-3 border border-[#D6D3D1] text-[#1C1917] text-sm font-medium rounded-full hover:border-[#1C1917] transition-colors"
                    >
                        <Mail class="w-4 h-4" />
                        Contactar
                    </a>
                </div>

                <div class="flex flex-wrap gap-2 pt-2">
                    <span
                        class="px-3 py-1 text-xs font-medium text-[#78716C] border border-[#E7E5E4] rounded-full"
                        >React Native</span
                    >
                    <span
                        class="px-3 py-1 text-xs font-medium text-[#78716C] border border-[#E7E5E4] rounded-full"
                        >Expo</span
                    >
                    <span
                        class="px-3 py-1 text-xs font-medium text-[#78716C] border border-[#E7E5E4] rounded-full"
                        >Node.js</span
                    >
                    <span
                        class="px-3 py-1 text-xs font-medium text-[#78716C] border border-[#E7E5E4] rounded-full"
                        >Astro</span
                    >
                    <span
                        class="px-3 py-1 text-xs font-medium text-[#78716C] border border-[#E7E5E4] rounded-full"
                        >Tailwind</span
                    >
                </div>
            </div>

            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <div class="relative">
                    <div
                        class="w-64 h-64 lg:w-80 lg:h-80 rounded-2xl overflow-hidden border border-[#E7E5E4]"
                    >
                        <Image
                            src={agus}
                            alt="Agustín Arla - Desarrollador Fullstack"
                            width={320}
                            height={320}
                            class="w-full h-full object-cover"
                            loading="eager"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
