---
import { Code, Server, Smartphone, Database, Palette } from "lucide-astro";

const technologies = [
  { name: "React Native", icon: Smartphone, description: "Mobile" },
  { name: "Astro", icon: Code, description: "Framework" },
  { name: "Tailwind CSS", icon: Palette, description: "Estilos" },
  { name: "Node.js", icon: Server, description: "Backend" },
  { name: "PostgreSQL", icon: Database, description: "Base de datos" },
];
---

<section id="tecnologias" class="py-24 bg-[#FAFAF9]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="mb-16">
      <p class="text-sm font-medium tracking-widest uppercase text-[#A8A29E] mb-3">
        Stack
      </p>
      <h2 class="text-3xl lg:text-4xl font-bold tracking-tight" style="font-family: var(--font-display);">
        Tecnologías
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {technologies.map((tech) => (
        <div class="group p-6 rounded-xl border border-[#E7E5E4] hover:border-[#D6D3D1] hover:shadow-sm transition-all duration-300">
          <div class="w-10 h-10 flex items-center justify-center mb-4 text-[#78716C] group-hover:text-[#1C1917] transition-colors">
            <tech.icon class="w-5 h-5" />
          </div>
          <p class="text-sm font-semibold text-[#1C1917] mb-1">{tech.name}</p>
          <p class="text-xs text-[#A8A29E]">{tech.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
