---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/camera-outline.svg" />
		<meta name="description" content="Portafolio de Agustín Arla, desarrollador web full-stack especializado en Astro, React y Node.js" />
		<meta name="keywords" content="Agustín Arla, desarrollador web, Astro, React, Node.js, portafolio" />
		<meta name="author" content="Agustín Arla" />
		<meta name="robots" content="index, follow" />
		<meta name="generator" content={Astro.generator} />
		<title>Agustín Arla </title>
		<link rel="stylesheet" href="/src/styles/global.css" />
		<style>
			html {
				scroll-behavior: smooth;
			}
			
			/* Offset para el header sticky */
			section[id] {
				scroll-margin-top: 80px;
			}
		</style>
	</head>
	<body class="bg-white">
		<Header />
		<main>
			<slot />
		</main>
		<Footer /> 
	</body>
</html>
